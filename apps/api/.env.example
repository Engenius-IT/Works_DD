# Self-hosted PromptPay configuration
# Use the phone number (10 digits) or citizen/company tax ID (13 digits)
# that receives the money in your own bank account.
PROMPTPAY_ID=0812345678
PROMPTPAY_MERCHANT_NAME=WORKSDD
# ชื่อผู้รับเงินที่ต้องตรงกับข้อมูลใน QR ของสลิป
PROMPTPAY_EXPECTED_NAME=WORKSDD
PROMPTPAY_CITY=BANGKOK

# Optional local-only payment test amount. Leave empty for real plan prices.
PAYMENT_TEST_MODE=false
PAYMENT_TEST_AMOUNT=

# 1xSlip bank slip verification (server-side only)
XSLIP_VERIFY_URL=https://api.1xslip.com/api/v2/verify/bank
XSLIP_API_KEY=
